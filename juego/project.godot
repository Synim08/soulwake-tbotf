; Aventura del Valle — Godot 4.7.2
config_version=5

[application]
config/name="Aventura del Valle"
run/main_scene="res://scenes/expedition.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="0.5.0-dev"

[autoload]
Game="*res://scripts/game.gd"
Expedition="*res://scripts/expedition.gd"

[display]
window/size/viewport_width=1152
window/size/viewport_height=768
window/size/window_width_override=1152
window/size/window_height_override=768
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)

[debug]
gdscript/warnings/untyped_declaration=0
